rules_version = '2';

// =====================================================================
// Reglas de seguridad de la barbería (Cloud Firestore)
// Cópialas tal cual en Firebase → Firestore Database → Reglas → Publicar.
//
// Administrador: una cuenta normal que pulsa «Soy el administrador» e
// introduce la súper contraseña. Aquí solo está su huella SHA-256: la
// contraseña no aparece en ningún sitio. Solo puede haber uno.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function ownerPath() { return /databases/$(database)/documents/meta/owner; }
    function isOwner() {
      return signedIn() && exists(ownerPath()) && get(ownerPath()).data.uid == request.auth.uid;
    }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // --- Administrador único -------------------------------------------
    match /meta/owner {
      allow get: if true;
      allow create: if signedIn() && !exists(ownerPath())
                    && request.resource.data.uid == uid()
                    && existsAfter(/databases/$(database)/documents/ownerKeys/$(uid()));
      allow update, delete: if false;
    }
    // La súper contraseña se comprueba aquí y nunca se puede leer
    match /ownerKeys/{userId} {
      allow create: if signedIn() && userId == uid()
                    && hashing.sha256(request.resource.data.key).toHexString().lower()
                       == '5bb84f088791b57791ff27a9aa197f78a84547e4a42cac7d868cbe7baa6b36b6';
      allow read, update, delete: if false;
    }

    // --- Datos públicos de la barbería -----------------------------------
    match /shop/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /services/{id} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /barbers/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    // --- Clientes --------------------------------------------------------
    match /users/{userId} {
      allow read: if signedIn() && (userId == uid() || isOwner());
      allow create, update: if signedIn() && userId == uid();
      allow delete: if signedIn() && (userId == uid() || isOwner());
      // dispositivos para las notificaciones push
      match /tokens/{token} {
        allow read, write: if signedIn() && userId == uid();
      }
    }
    // Notas privadas del barbero sobre cada cliente
    match /clientNotes/{userId} {
      allow read, write: if isOwner();
    }

    // --- Reservas --------------------------------------------------------
    match /bookings/{id} {
      allow read: if isOwner() || (signedIn() && resource.data.userId == uid());
      allow create: if isOwner() || (signedIn() && request.resource.data.userId == uid()
                        && request.resource.data.status == 'confirmada');
      allow update: if isOwner()
        || (signedIn() && resource.data.userId == uid() && resource.data.status == 'confirmada'
            && changes().hasOnly(['status', 'cancelledAt']) && request.resource.data.status == 'cancelada')
        || (signedIn() && resource.data.userId == uid() && resource.data.status == 'completada'
            && changes().hasOnly(['rating', 'review', 'ratedAt']));
      allow delete: if isOwner();
    }
    // Huecos ocupados (uno por cada 15 min). El id es único, así que es
    // imposible reservar dos veces la misma hora con el mismo barbero.
    match /slots/{id} {
      allow read: if signedIn();
      allow create: if isOwner() || (signedIn() && request.resource.data.userId == uid()
                        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId == uid());
      allow delete: if isOwner() || (signedIn() && resource.data.userId == uid());
      allow update: if false;
    }

    // --- Fotos de los cortes ---------------------------------------------
    match /photos/{id} {
      allow read: if isOwner() || (signedIn() && resource.data.userId == uid());
      allow create: if isOwner();
      allow delete: if isOwner();
    }

    // --- Notificaciones --------------------------------------------------
    // to: id del cliente, 'owner' (para el barbero) o 'all' (promociones)
    match /notifications/{id} {
      allow read: if signedIn() && (resource.data.to == uid() || resource.data.to == 'all'
                     || (resource.data.to == 'owner' && isOwner()));
      allow create: if signedIn() && request.resource.data.from == uid()
                    && (request.resource.data.to == 'owner' || isOwner());
      allow update, delete: if isOwner();
    }
  }
}
