rules_version = '2';

// =====================================================================
// Reglas de seguridad de Visvet (Cloud Firestore)
// Cópialas en Firebase → Firestore Database → Reglas → Publicar.
//
// IMPORTANTE: sustituye ADMIN_EMAIL_AQUI por el correo de la cuenta
// de la clínica (en minúsculas), el mismo que en js/config.js.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    // La clínica: su correo y verificado (nadie puede hacerse pasar por ella)
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'ADMIN_EMAIL_AQUI'
        && request.auth.token.email_verified == true;
    }
    function petOwner(petId) {
      return get(/databases/$(database)/documents/pets/$(petId)).data.ownerId;
    }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Datos de la clínica (horario, teléfono…): todos los leen, solo la clínica edita
    match /clinic/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Perfiles de usuario
    match /users/{userId} {
      allow read: if signedIn() && (userId == uid() || isAdmin());
      allow create, update: if signedIn() && userId == uid();
      allow delete: if signedIn() && (userId == uid() || isAdmin());
    }

    // Animales: cada cliente ve y gestiona los suyos; la clínica, todos
    match /pets/{petId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerId == uid());
      allow create: if isAdmin() || (signedIn() && request.resource.data.ownerId == uid());
      allow update: if isAdmin() || (signedIn() && resource.data.ownerId == uid()
                        && request.resource.data.ownerId == uid()
                        && !changes().hasAny(['pendingAmount', 'readByAdminAt']));
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == uid());

      // Chat privado de cada animal con la clínica
      match /messages/{msgId} {
        allow read: if isAdmin() || (signedIn() && petOwner(petId) == uid());
        allow create: if (isAdmin() && request.resource.data.fromAdmin == true && request.resource.data.from == uid())
                      || (signedIn() && petOwner(petId) == uid()
                          && request.resource.data.from == uid() && request.resource.data.fromAdmin == false);
        allow update, delete: if isAdmin();
      }

      // Cartilla: el cliente la lee; solo la clínica escribe
      match /records/{recId} {
        allow read: if isAdmin() || (signedIn() && petOwner(petId) == uid());
        allow write: if isAdmin();
      }
    }

    // Citas
    match /appointments/{apptId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerId == uid());
      allow create: if isAdmin() || (signedIn() && request.resource.data.ownerId == uid()
                        && request.resource.data.status == 'pendiente');
      allow update: if isAdmin() || (signedIn() && resource.data.ownerId == uid()
                        && changes().hasOnly(['status']) && request.resource.data.status == 'cancelada');
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == uid());
    }

    // Archivos (troceados): los ve el dueño del animal y la clínica
    match /files/{fileId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerId == uid());
      allow create: if signedIn() && request.resource.data.createdBy == uid()
                    && (isAdmin() || request.resource.data.ownerId == uid());
      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == uid());

      match /chunks/{n} {
        allow read: if isAdmin()
                    || (signedIn() && get(/databases/$(database)/documents/files/$(fileId)).data.ownerId == uid());
        allow create: if isAdmin()
                    || (signedIn() && get(/databases/$(database)/documents/files/$(fileId)).data.createdBy == uid());
        allow delete: if isAdmin()
                    || (signedIn() && get(/databases/$(database)/documents/files/$(fileId)).data.createdBy == uid());
      }
    }
  }
}
