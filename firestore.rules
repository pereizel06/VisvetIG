rules_version = '2';

// Reglas de seguridad de Visvet para Cloud Firestore.
// Cópialas en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Nombres de usuario reservados (para que no se repitan)
    match /usernames/{name} {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.uid == me()
        && name.matches('^[a-z0-9._]{3,30}$');
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Perfiles: los ve cualquier usuario registrado; solo los edita su dueño
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && uid == me()
        && request.resource.data.role in ['vet', 'client'];
      allow update: if signedIn() && uid == me()
        && request.resource.data.role == resource.data.role
        && request.resource.data.username == resource.data.username;
      allow delete: if signedIn() && uid == me();
    }

    // Publicaciones: el autor la gestiona; los demás solo pueden
    // dar «me gusta», guardar y comentar
    match /posts/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == me();
      allow update: if signedIn() && (
        (resource.data.userId == me() && request.resource.data.userId == me())
        || onlyChanged(['likes', 'savedBy', 'comments']));
      allow delete: if signedIn() && resource.data.userId == me();
    }

    // Fotos (comprimidas) de publicaciones e historias
    match /media/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == me()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
      allow delete: if signedIn() && resource.data.userId == me();
    }

    // Historias (24 h)
    match /stories/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == me();
      allow update: if signedIn() && onlyChanged(['seenBy']);
      allow delete: if signedIn() && resource.data.userId == me();
    }

    // Citas: solo las ven el cliente y el veterinario implicados.
    // El cliente solicita y puede cancelar; el veterinario confirma,
    // rechaza, completa y añade notas.
    match /appointments/{id} {
      allow read: if signedIn()
        && (resource.data.clientId == me() || resource.data.vetId == me());
      allow create: if signedIn()
        && request.resource.data.clientId == me()
        && request.resource.data.status == 'pendiente';
      allow update: if signedIn() && (
        (resource.data.vetId == me() && onlyChanged(['status', 'vetNote']))
        || (resource.data.clientId == me() && onlyChanged(['status'])
            && request.resource.data.status == 'cancelada'));
      allow delete: if signedIn()
        && (resource.data.clientId == me() || resource.data.vetId == me());
    }

    // Mensajes privados: solo los ven emisor y receptor
    match /messages/{id} {
      allow read: if signedIn()
        && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn()
        && request.resource.data.from == me()
        && request.resource.data.read == false;
      allow update: if signedIn() && resource.data.to == me() && onlyChanged(['read']);
      allow delete: if signedIn() && resource.data.from == me();
    }

    // Notificaciones: solo las ve su destinatario
    match /notifications/{id} {
      allow read, update, delete: if signedIn() && resource.data.userId == me();
      allow create: if signedIn() && request.resource.data.fromId == me();
    }
  }
}
